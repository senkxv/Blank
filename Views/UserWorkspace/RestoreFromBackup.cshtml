@{
    Layout = "_Layout";
    ViewData["Title"] = "Восстановление из бэкапа";
}

<link rel="stylesheet" href="/css/UserWorkspace/RestoreFromBackup.css" asp-append-version="true" />

<div class="table-container">
    <h2>Восстановление базы данных</h2>
    
        <div class="alert alert-warning">
            <div class="alert-warning-content">
                <span class="alert-icon"></span>
                <div>
                    <strong>Внимание!</strong><br />
                    Это действие полностью заменит все текущие данные в базе.
                    <span class="text-danger-bold">Операция необратима!</span>
                    <strong>Рекомендация:</strong> Перед восстановлением рекомендуется создать резервную копию текущих данных.
                </div>
            </div>
        </div>

    <form asp-action="RestoreFromBackup"
          asp-controller="UserWorkspace"
          method="post"
          enctype="multipart/form-data"
          id="restoreForm"
          class="restore-form">

        <div class="file-upload-section">
            <label for="file" class="file-label">
                Выберите файл бэкапа (.xlsx):
            </label>
            <div class="file-input-wrapper">
                <input type="file"
                       name="file"
                       id="file"
                       accept=".xlsx"
                       required
                       class="file-input-hidden" />
                <button type="button" class="btn-choose-file" onclick="document.getElementById('file').click()">
                    Выберите файл
                </button>
                <span id="fileNameText" class="file-name-text">Файл не выбран</span>
            </div>
        </div>

        <div class="confirm-section">
            <label class="confirm-label">
                <input type="checkbox" id="confirmRestore" required class="confirm-checkbox" />
                <span class="confirm-text">
                    Я понимаю, что все текущие данные будут удалены
                </span>
            </label>
        </div>

        <div class="form-buttons">
            <a href="@Url.Action("Index", "UserWorkspace")" class="btn-back">
                ← Отмена
            </a>
            <button type="submit" id="restoreBtn" disabled class="btn-restore">
                Восстановить из бэкапа
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="/js/UserWorkspace/RestoreFromBackup.js"></script>
}