@model Blank.Models.Tables.Documents

@{
    Layout = "_Layout";
    ViewData["Title"] = "Добавление документа";
    
    var routesList = ViewBag.AvailableRoutes as IEnumerable<dynamic>;
    var hasRoutes = routesList != null && routesList.Any();
}

<link rel="stylesheet" href="/css/UserWorkspace/CreateDocumentPage.css" asp-append-version="true" />

<div class="form-container">
    <h2>Добавление документа</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    @* ✅ Выбор маршрута — ВЫПАДАЮЩИЙ СПИСОК *@
    <div class="route-selection">
        <h3>Выберите маршрут (опционально):</h3>
        
        <select id="routeSelect" class="route-select"
                onchange="if(this.value) window.location.href='@Url.Action("CreateDocumentPage")?routeId=' + this.value;">
            <option value="">-Без маршрута-</option>
            @if (hasRoutes)
            {
                foreach (var route in routesList)
                {
                    <option value="@route.ид_маршрута" selected="@(ViewBag.RouteId == route.ид_маршрута ? "selected" : null)">
                        @route.название
                    </option>
                }
            }
        </select>
    </div>

    @* Прогресс по маршруту *@
    @if (ViewBag.SelectedRoute != null)
    {
        <div class="route-progress">
            <h4>Маршрут: @ViewBag.SelectedRoute.название</h4>
            <div class="progress-bar">
                @for (int i = 0; i < ViewBag.TotalPoints; i++)
                {
                    <span class="progress-point @(i < ViewBag.CurrentPointIndex ? "completed" : i == ViewBag.CurrentPointIndex ? "current" : "pending")">
                        Точка @(i + 1)
                    </span>
                    @if (i < ViewBag.TotalPoints - 1)
                    {
                        <span class="progress-arrow">→</span>
                    }
                }
            </div>
            <p class="route-info">Текущая точка: @(ViewBag.CurrentPointIndex + 1) из @ViewBag.TotalPoints</p>
        </div>
    }

    <div id="skipPointModal" class="notification-modal" style="display:none;">
        <div class="notification-content">
            <p id="skipPointMessage"></p>
            <div class="notification-buttons">
                <button id="skipPointConfirmBtn" class="btn-save">Да, пропустить</button>
                <button id="skipPointCancelBtn" class="btn-cancel">Отмена</button>
            </div>
        </div>
    </div>

    <form method="post" asp-action="CreateDocumentPage" class="document-form" id="documentForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* Скрытые поля для маршрута *@
        @if (ViewBag.RouteId != null)
        {
            <input type="hidden" name="routeId" value="@ViewBag.RouteId" />
            <input type="hidden" name="currentPointIndex" value="@ViewBag.CurrentPointIndex" />
        }

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="ид_типа">Тип документа</label>
                <select asp-for="ид_типа" class="form-control" required>
                    <option value="">-Выберите тип-</option>
                    @foreach (var type in ViewBag.DocumentTypes)
                    {
                        <option value="@type.ид_типа"
                                selected="@(ViewBag.DefaultDocumentType == type.ид_типа)">
                            @type.краткое_наименование
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="номер_документа">Номер документа</label>
                <input asp-for="номер_документа" class="form-control" required
                       value="@(ViewBag.NextDocumentNumber ?? "")" />
            </div>

            <div class="form-group">
                <label asp-for="дата_создания">Дата создания</label>
                <input asp-for="дата_создания" type="date" class="form-control" required
                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div class="form-group">
                <label asp-for="ид_грузоотправителя">Грузоотправитель</label>
                <select asp-for="ид_грузоотправителя" class="form-control" required>
                    <option value="">-Выберите организацию-</option>
                    @foreach (var org in ViewBag.Organizations)
                    {
                        <option value="@org.ид_организации"
                                selected="@(ViewBag.DefaultSenderId == org.ид_организации)">
                            @org.название
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_перевозчика">Перевозчик</label>
                <select asp-for="ид_перевозчика" class="form-control" required>
                    <option value="">-Выберите организацию-</option>
                    @foreach (var org in ViewBag.Organizations)
                    {
                        <option value="@org.ид_организации"
                                selected="@(ViewBag.SelectedRoute?.ид_перевозчика == org.ид_организации)">
                            @org.название
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_получателя">Грузополучатель</label>
                <select asp-for="ид_получателя" class="form-control" required>
                    <option value="">-Выберите организацию-</option>
                    @foreach (var org in ViewBag.Organizations)
                    {
                        <option value="@org.ид_организации"
                                selected="@(ViewBag.DefaultReceiverId == org.ид_организации)">
                            @org.название
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_водителя">Водитель</label>
                <select asp-for="ид_водителя" class="form-control" required>
                    <option value="">-Выберите водителя-</option>
                    @foreach (var driver in ViewBag.Drivers)
                    {
                        <option value="@driver.ид_водителя"
                                selected="@(ViewBag.SelectedRoute?.ид_водителя == driver.ид_водителя)">
                            @driver.фамилия @driver.имя @driver.отчество
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_транспорта">Транспорт</label>
                <select asp-for="ид_транспорта" class="form-control" required>
                    <option value="">-Выберите транспорт-</option>
                    @foreach (var t in ViewBag.Transport)
                    {
                        <option value="@t.ид_транспорта"
                                selected="@(ViewBag.SelectedRoute?.ид_транспорта == t.ид_транспорта)">
                            @t.регистрационный_номер
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_пункта_погрузки">Пункт погрузки</label>
                <select asp-for="ид_пункта_погрузки" class="form-control">
                    <option value="">-Выберите пункт погрузки-</option>
                    @foreach (var point in ViewBag.LoadingPoints)
                    {
                        <option value="@point.ид_пункта_погрузки"
                                selected="@(ViewBag.CurrentPoint?.ид_пункта_погрузки == point.ид_пункта_погрузки)">
                            @point.наименование
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="ид_пункта_разгрузки">Пункт разгрузки</label>
                <select asp-for="ид_пункта_разгрузки" class="form-control">
                    <option value="">-Выберите пункт разгрузки-</option>
                    @foreach (var point in ViewBag.UnloadingPoints)
                    {
                        <option value="@point.ид_пункта_разгрузки"
                                selected="@(ViewBag.CurrentPoint?.ид_пункта_разгрузки == point.ид_пункта_разгрузки)">
                            @point.наименование
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="отпуск_разрешил">Отпуск разрешил (ФИО, должность)</label>
                <input asp-for="отпуск_разрешил" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="сдал_грузоотправитель">Сдал грузоотправитель (ФИО, должность)</label>
                <input asp-for="сдал_грузоотправитель" class="form-control" />
            </div>
        </div>

        @* Таблица товаров *@
        <div class="goods-section">
            <h3>Товары (позиции накладной)</h3>
            <div class="table-wrapper">
                <table class="goods-table" id="goodsTable">
                    <thead>
                        <tr>
                            <th>Товар</th>
                            <th>Ед. изм.</th>
                            <th>Кол-во</th>
                            <th>Цена</th>
                            <th>Скидка,%</th>
                            <th>НДС,%</th>
                            <th>Стоимость без НДС</th>
                            <th>Сумма НДС</th>
                            <th>Стоимость с НДС</th>
                            <th>Масса, кг</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="goodsTableBody">
                        <tr id="noDataRow">
                            <td colspan="11" style="text-align: center;">Нет добавленных товаров</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="11" style="text-align: center;">
                                <button type="button" id="addGoodsBtn" class="btn-add">+ Добавить товар</button>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="goods-summary">
                <span>Итого масса: </span>
                <span id="totalWeight">0</span> кг
            </div>
        </div>

        <div class="form-actions">
            @if (ViewBag.RouteId != null && !(bool)(ViewBag.IsLastPoint ?? true))
            {
                <button type="submit" name="action" value="next" class="btn-save">
                    Сохранить и следующая точка 
                </button>
                <button type="button" id="skipPointBtn" class="btn-skip">
                    Пропустить точку
                </button>
            }
            else
            {
                <button type="submit" name="action" value="save" class="btn-save">
                    Сохранить
                </button>
            }
            <a href="@Url.Action("Index", "UserWorkspace")" class="btn-cancel-route">Отмена</a>
        </div>

        <input type="hidden" name="positionsData" id="positionsData" />
    </form>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@section Scripts {
    <script>
        window.goodsListData = @Html.Raw(ViewBag.GoodsJson);
    </script>
    <script src="/js/UserWorkspace/CreateDocumentPage.js"></script>
}