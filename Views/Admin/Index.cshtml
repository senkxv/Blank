@{
    Layout = "_Layout";
    ViewData["Title"] = "Управление";
}

<link rel="stylesheet" href="/css/Admin/Index.css" />
<style>
    body.admin-loading .tab-content {
        display: none;
    }
</style>
<script>
    document.body.classList.add('admin-loading');
</script>

<!-- Модальное окно подтверждения -->
<div id="confirmActionModal" style="display:none;">
    <div class="notification-content">
        <p id="confirmActionMessage"></p>
        <div class="notification-buttons">
            <button id="confirmActionYes" class="btn-save">Да</button>
            <button id="confirmActionNo" class="btn-cancel">Нет</button>
        </div>
    </div>
</div>

<div class="admin-panel">
    <h2>Управление</h2>

    <div class="tabs">
        <button class="tab" data-tab="organizations">Организации</button>
        <button class="tab" data-tab="drivers">Водители</button>
        <button class="tab" data-tab="transport">Транспорт</button>
        <button class="tab" data-tab="goods">Товары</button>
        <button class="tab" data-tab="points">Пункты погрузки/разгрузки</button>
        <button class="tab" data-tab="routes">Маршруты</button>
        <button class="tab" data-tab="users">Пользователи</button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background: #f8d7da; color: #721c24; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Debug"] != null)
    {
        <div style="background: #fff3cd; color: #856404; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
            @TempData["Debug"]
        </div>
    }

    <!-- Вкладка: Организации -->
    <div class="tab-content" id="tab-organizations">
        <h3 class="section-title">Организации</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>УНП</th>
                    <th>Адрес</th>
                    <th>Почта</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="orgTableBody">
                @foreach (var org in ViewBag.Organizations)
                {
                    <tr data-id="@org.ид_организации">
                        <td><input type="text" class="edit-name" value="@org.название" /></td>
                        <td><input type="text" class="edit-unp" value="@org.унп" /></td>
                        <td><input type="text" class="edit-address" value="@org.адрес" /></td>
                        <td><input type="text" class="edit-email" value="@org.почта" /></td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Добавить организацию</h4>
        <form id="addOrgForm" class="admin-form inline-form">
            <input type="text" name="name" placeholder="Название" required />
            <input type="text" name="unp" placeholder="УНП" />
            <input type="text" name="address" placeholder="Адрес" />
            <input type="email" name="email" placeholder="Почта" />
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>

    <!-- Вкладка: Водители -->
    <div class="tab-content" id="tab-drivers">
        <h3 class="section-title">Водители</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Отчество</th>
                    <th>Номер лицензии</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="driversTableBody">
                @foreach (var driver in ViewBag.Drivers)
                {
                    <tr data-id="@driver.ид_водителя">
                        <td><input type="text" class="edit-lastname" value="@driver.фамилия" /></td>
                        <td><input type="text" class="edit-firstname" value="@driver.имя" /></td>
                        <td><input type="text" class="edit-middlename" value="@driver.отчество" /></td>
                        <td><input type="text" class="edit-license" value="@driver.номер_лицензии" /></td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <h4>Добавить водителя</h4>
        <form id="addDriverForm" class="admin-form inline-form">
            <input type="text" name="lastName" placeholder="Фамилия" required />
            <input type="text" name="firstName" placeholder="Имя" required />
            <input type="text" name="middleName" placeholder="Отчество" />
            <input type="text" name="licenseNumber" placeholder="Номер лицензии" />
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>

    <!-- Вкладка: Транспорт -->
    <div class="tab-content" id="tab-transport">
        <h3 class="section-title">Транспорт</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Рег. номер</th>
                    <th>Марка</th>
                    <th>Тип ТС</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="transportTableBody">
                @foreach (var t in ViewBag.TransportList)
                {
                    <tr data-id="@t.ид_транспорта">
                        <td><input type="text" class="edit-regnumber" value="@t.регистрационный_номер" /></td>
                        <td>
                            <select class="edit-brand">
                                @foreach (var mark in ViewBag.TransportMarks)
                                {
                                    <option value="@mark.ид_марки" selected="@(mark.ид_марки == t.ид_марки)">@mark.наименование_марки</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="edit-type">
                                @foreach (var type in ViewBag.TransportTypes)
                                {
                                    <option value="@type.ид_типа_транспорта" selected="@(type.ид_типа_транспорта == t.ид_типа_транспорта)">@type.наименование_типа</option>
                                }
                            </select>
                        </td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Добавить транспорт</h4>
        <form id="addTransportForm" class="admin-form inline-form">
            <input type="text" name="regNumber" placeholder="Рег. номер" required />
            <input type="text" name="brandName" placeholder="Марка (например: MAN)" required />
            <input type="text" name="typeName" placeholder="Тип ТС (например: Фура)" required />
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>

    <!-- Вкладка: Товары -->
    <div class="tab-content" id="tab-goods">
        <h3 class="section-title">Товары</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Код товара</th>
                    <th>Наименование</th>
                    <th>Ед. измерения</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="goodsTableBody">
                @foreach (var goods in ViewBag.Goods)
                {
                    <tr data-id="@goods.ид_товара">
                        <td><input type="text" class="edit-code" value="@goods.код_товара" /></td>
                        <td><input type="text" class="edit-name" value="@goods.наименование" /></td>
                        <td><input type="text" class="edit-unit" value="@goods.единицы_измерения" /></td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Добавить товар</h4>
        <form id="addGoodsForm" class="admin-form inline-form">
            <input type="text" name="code" placeholder="Код товара" />
            <input type="text" name="name" placeholder="Наименование" required />
            <input type="text" name="unit" placeholder="Ед. измерения" />
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>

    <!-- Вкладка: Пункты погрузки/разгрузки -->
    <div class="tab-content" id="tab-points">
        <h3 class="section-title">Пункты погрузки</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Наименование</th>
                    <th>Адрес</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="loadingTableBody">
                @foreach (var point in ViewBag.LoadingPoints)
                {
                    <tr data-id="@point.ид_пункта_погрузки">
                        <td><input type="text" class="edit-name" value="@point.наименование" /></td>
                        <td><input type="text" class="edit-address" value="@point.адрес" /></td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Добавить пункт погрузки</h4>
        <form id="addLoadingForm" class="admin-form inline-form">
            <input type="text" name="name" placeholder="Наименование" required />
            <input type="text" name="address" placeholder="Адрес" />
            <button type="submit" class="btn-add">Добавить</button>
        </form>

        <h3 class="section-title" style="margin-top: 30px;">Пункты разгрузки</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Наименование</th>
                    <th>Адрес</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="unloadingTableBody">
                @foreach (var point in ViewBag.UnloadingPoints)
                {
                    <tr data-id="@point.ид_пункта_разгрузки">
                        <td><input type="text" class="edit-name" value="@point.наименование" /></td>
                        <td><input type="text" class="edit-address" value="@point.адрес" /></td>
                        <td>
                            <button class="btn-update">Сохранить</button>
                            <button class="btn-delete">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Добавить пункт разгрузки</h4>
        <form id="addUnloadingForm" class="admin-form inline-form">
            <input type="text" name="name" placeholder="Наименование" required />
            <input type="text" name="address" placeholder="Адрес" />
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>

    <!-- Вкладка: Маршруты -->
    <div class="tab-content" id="tab-routes">
        <h3 class="section-title">Маршруты</h3>

        <div id="editRouteModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:30px; border-radius:10px; width:700px; max-height:80vh; overflow-y:auto;">
                <h3>Редактирование маршрута</h3>
                <form id="editRouteForm">
                    <input type="hidden" id="editRouteId" />
                    <div class="form-group">
                        <label>Название маршрута</label>
                        <input type="text" id="editRouteName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Водитель</label>
                        <select id="editDriverId" class="form-control">
                            <option value="">-- Не назначен --</option>
                            @foreach (var driver in ViewBag.Drivers)
                            {
                                <option value="@driver.ид_водителя">@driver.фамилия @driver.имя</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Транспорт</label>
                        <select id="editTransportId" class="form-control">
                            <option value="">-- Не назначен --</option>
                            @foreach (var t in ViewBag.Transport)
                            {
                                <option value="@t.ид_транспорта">@t.регистрационный_номер</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Перевозчик</label>
                        <select id="editCarrierId" class="form-control">
                            <option value="">-- Не назначен --</option>
                            @foreach (var org in ViewBag.Organizations)
                            {
                                <option value="@org.ид_организации">@org.название</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Статус</label>
                        <select id="editStatus" class="form-control">
                            <option value="активен">Активен</option>
                            <option value="неактивен">Неактивен</option>
                        </select>
                    </div>
                    <h4 style="margin-top: 20px;">Точки маршрута</h4>
                    <div id="editRoutePointsContainer"></div>
                    <button type="button" id="addEditPointBtn" class="btn-add" style="margin-top:10px;">+ Добавить точку</button>
                    <div style="margin-top:20px; display:flex; gap:10px;">
                        <button type="submit" class="btn-save">Сохранить</button>
                        <button type="button" onclick="document.getElementById('editRouteModal').style.display='none'" class="btn-cancel">Отмена</button>
                    </div>
                </form>
            </div>
        </div>
        
        <div id="routesList">
            @if (ViewBag.Routes != null)
            {
                foreach (var route in ViewBag.Routes)
                {
                    <div class="route-card" data-id="@route.ид_маршрута">
                        <div class="route-header">
                            <h4>@route.название</h4>
                            <span class="route-status @route.статус">@route.статус</span>
                        </div>
                        <div class="route-info">
                            <p>Водитель: @(route.Водитель != null ? $"{route.Водитель.фамилия} {route.Водитель.имя}" : "Не назначен")</p>
                            <p>Транспорт: @(route.Транспорт?.регистрационный_номер ?? "Не назначен")</p>
                            <p>Перевозчик: @(route.Перевозчик?.название ?? "Не назначен")</p>
                        </div>
                        <div class="route-points">
                            <h5>Точки маршрута:</h5>
                            <ol>
                                @if (route.ТочкиМаршрута != null)
                                {
                                    foreach (var point in route.ТочкиМаршрута)
                                    {
                                        <li>
                                            @(point.ПунктПогрузки?.наименование ?? "—")
                                            →
                                            @(point.ПунктРазгрузки?.наименование ?? "—")
                                        </li>
                                    }
                                }
                            </ol>
                        </div>
                        <div class="route-actions">
                            <button class="btn-edit" onclick="editRoute(@route.ид_маршрута)">Редактировать</button>
                            <button class="btn-delete" onclick="deleteRoute(@route.ид_маршрута)">Удалить</button>
                        </div>
                    </div>
                }
            }
        </div>

        <h4>Создать новый маршрут</h4>
        <form id="addRouteForm" class="admin-form" method="post" action="/Admin/CreateRoute">
            <div class="form-group">
                <label>Название маршрута</label>
                <input type="text" name="routeName" placeholder="Например: Минск-Гомель-Могилев" required />
            </div>
            <div class="form-group">
                <label>Водитель (по умолчанию)</label>
                <select name="driverId">
                    <option value="">-- Не назначен --</option>
                    @if (ViewBag.Drivers != null)
                    {
                        foreach (var driver in ViewBag.Drivers)
                        {
                            <option value="@driver.ид_водителя">@driver.фамилия @driver.имя @driver.отчество</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Транспорт (по умолчанию)</label>
                <select name="transportId">
                    <option value="">-- Не назначен --</option>
                    @if (ViewBag.Transport != null)
                    {
                        foreach (var t in ViewBag.Transport)
                        {
                            <option value="@t.ид_транспорта">@t.регистрационный_номер</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Перевозчик (по умолчанию)</label>
                <select name="carrierId">
                    <option value="">-- Не назначен --</option>
                    @if (ViewBag.Organizations != null)
                    {
                        foreach (var org in ViewBag.Organizations)
                        {
                            <option value="@org.ид_организации">@org.название</option>
                        }
                    }
                </select>
            </div>
            <h5>Точки маршрута</h5>
            <div id="routePointsContainer">
                <div class="route-point-row">
                    <span class="point-number">1</span>
                    <select name="senderId[]" class="sender-select">
                        <option value="">-- Грузоотправитель --</option>
                        @foreach (var org in ViewBag.Organizations)
                        {
                            <option value="@org.ид_организации">@org.название</option>
                        }
                    </select>
                    <select name="loadingPointId[]" class="loading-point-select">
                        <option value="">-- Пункт погрузки --</option>
                        @foreach (var point in ViewBag.LoadingPoints)
                        {
                            <option value="@point.ид_пункта_погрузки">@point.наименование</option>
                        }
                    </select>
                    <span>→</span>
                    <select name="unloadingPointId[]" class="unloading-point-select">
                        <option value="">-- Пункт разгрузки --</option>
                        @foreach (var point in ViewBag.UnloadingPoints)
                        {
                            <option value="@point.ид_пункта_разгрузки">@point.наименование</option>
                        }
                    </select>
                    <select name="receiverId[]" class="receiver-select">
                        <option value="">-- Грузополучатель --</option>
                        @foreach (var org in ViewBag.Organizations)
                        {
                            <option value="@org.ид_организации">@org.название</option>
                        }
                    </select>
                    <button type="button" class="btn-remove-point" style="display:none;">✖</button>
                </div>
            </div>
            <button type="button" id="addPointBtn" class="btn-add">Добавить точку</button>
            <button type="submit" class="btn-add-outline">Создать маршрут</button>
        </form>
    </div>

    <!-- Вкладка: Пользователи -->
    <div class="tab-content" id="tab-users">
        <h3 class="section-title">Пользователи компании</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Отчество</th>
                    <th>Должность</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                @if (ViewBag.Users != null)
                {
                    foreach (var user in ViewBag.Users)
                    {
                        <tr data-id="@user.ид_пользователя">
                            <td>@user.почта</td>
                            <td>@user.фамилия</td>
                            <td>@user.имя</td>
                            <td>@user.отчество</td>
                            <td>
                                <select class="edit-role">
                                    <option value="1" selected="@(user.ид_должности == 1)">Администратор</option>
                                    <option value="3" selected="@(user.ид_должности == 3)">Пользователь</option>
                                </select>
                            </td>
                            <td>
                                <button class="btn-update-role">Сохранить</button>
                                <button class="btn-delete">Удалить</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <h4>Добавить пользователя</h4>
        <form id="addUserForm" class="admin-form inline-form">
            <input type="email" name="email" placeholder="Email" required />
            <input type="text" name="lastName" placeholder="Фамилия" required />
            <input type="text" name="firstName" placeholder="Имя" required />
            <input type="text" name="middleName" placeholder="Отчество" />
            <input type="password" name="password" placeholder="Пароль" required />
            <select name="roleId">
                <option value="3">Пользователь</option>
                <option value="1">Администратор</option>
            </select>
            <button type="submit" class="btn-add">Добавить</button>
        </form>
    </div>
</div>

<script src="/js/Admin/Index.js"></script>